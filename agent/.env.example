# === Anthropic API ===
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === Your WeChat Identity ===
MY_WECHAT_NAME=Your Name

# === Email Delivery ===
DELIVERY_METHOD=email
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# === Briefing Schedule ===
BRIEFING_TIME=07:30

# === Voice Transcription ===
# Options: base, small, medium (medium recommended for Chinese/English mix)
WHISPER_MODEL=medium

# === Cloud Sync (optional — for hosted dashboard) ===
VERCEL_KV_URL=
CLIENT_ID=
